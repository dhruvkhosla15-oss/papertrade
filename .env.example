# ---- price feed ----
# mock = simulated prices (for trying the app)   kite = live Zerodha prices
PT_FEED=kite
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# ---- security ----
# any long random string; change it!
PT_SECRET_KEY=change-me-to-a-long-random-string
# first-run master login (change the password after first login)
PT_ADMIN_USER=admin
PT_ADMIN_PASSWORD=admin123

# ---- platform ----
PT_UNDERLYINGS=NIFTY,BANKNIFTY,SENSEX
PT_ENFORCE_MARKET_HOURS=true

# ---- hosting (docker-compose + Caddy auto-HTTPS) ----
# your domain pointing at this server, e.g. trade.yourname.in
DOMAIN=localhost
